{
  "name": "soundscape-engine",
  "version": "0.5.0-rc.1",
  "description": "Browser-based music sequencer and synthesizer engine powered by the Web Audio API",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "audio",
    "web-audio",
    "synthesizer",
    "sequencer",
    "music",
    "daw",
    "synth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anthony-liddle/soundscape.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/anthony-liddle/soundscape/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/anthony-liddle/soundscape/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/soundscape-engine.js"
    }
  },
  "main": "./dist/soundscape-engine.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && vite build",
    "check:package": "publint && attw --pack . --profile esm-only",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --project tsconfig.test.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^24.19.1",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "node-web-audio-api": "^2.2.0",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.11"
  }
}
