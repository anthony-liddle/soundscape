{
  "name": "soundscape-engine",
  "version": "0.1.1",
  "description": "Browser-based music sequencer and synthesizer engine powered by the Web Audio API",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "audio",
    "web-audio",
    "synthesizer",
    "sequencer",
    "music",
    "daw",
    "synth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anthony-liddle/soundscape.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/anthony-liddle/soundscape/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/anthony-liddle/soundscape/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/soundscape-engine.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/soundscape-engine.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
